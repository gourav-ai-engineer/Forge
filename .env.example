# Scheduler
AI_ASSISTANT_INTERVAL=86400
AI_ASSISTANT_OPEN_PLATFORMS=false
AI_ASSISTANT_AUTO_PUBLISH=false

# Optional GitHub publishing
GITHUB_REPO=gourav-ai-engineer/Ai-Assistant
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Optional OpenAI-compatible LLM generation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
