# Optional OpenAI-backed planning
OPENAI_API_KEY=
FORGE_MODEL=gpt-4o-mini

# Optional GitHub issue fetching / pull-request creation
GITHUB_TOKEN=

# API security and workspace policy
FORGE_API_KEY=
FORGE_WORKSPACE=.
FORGE_ALLOWED_ROOT=

# Optional hybrid code retrieval (BM25 is the default, offline backend)
FORGE_USE_CHROMA=0

# Docker validation image; build it with:
# docker build -f Dockerfile.sandbox -t forge-sandbox:local .
FORGE_SANDBOX_IMAGE=forge-sandbox:local

# Unsafe opt-in for trusted local-only fixtures; leave disabled for normal use.
FORGE_ALLOW_UNSANDBOXED_TESTS=0
